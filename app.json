{
  "expo": {
    "name": "jantile-tracker-v2",
    "slug": "jantile-tracker-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jantile-logo.png",
    "scheme": "jantiletrackerv2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/jantile-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jantile.trackerv2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/jantile-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "@journeyapps/react-native-quick-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to attach images to issues.",
          "cameraPermission": "The app needs access to your camera to take photos of issues."
        }
      ],
      "expo-crypto",
      [
        "expo-media-library",
        {
          "photosPermission": "The app needs access to your photo library.",
          "savePhotosPermission": "The app needs permission to save photos."
        }
      ],
      "expo-print",
      "expo-sharing",
      "expo-haptics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "233479d4-4e40-4e51-84ec-b56b21655443"
      }
    }
  }
}
